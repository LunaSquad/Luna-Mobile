{
  "name": "luna",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "setup:front": "npm install",
    "setup:back": "cd backend && python -m venv venv && .\\venv\\Scripts\\python -m pip install --upgrade pip && .\\venv\\Scripts\\pip install -r requirements.txt",
    "setup": "npm run setup:front && npm run setup:back",
    "ip": "python setup_ip.py",
    "back": "cd backend && .\\venv\\Scripts\\python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --reload",
    "front": "npx expo start -c",
    "dev": "npm run ip && concurrently -n \"BACKEND,MOBILE\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run back\" \"npm run front\""
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-navigation/bottom-tabs": "^7.9.1",
    "@react-navigation/native": "^7.1.27",
    "@react-navigation/native-stack": "^7.3.28",
    "@react-navigation/stack": "^7.7.2",
    "expo": "54.0.22",
    "expo-app-loading": "^2.1.1",
    "expo-asset": "~12.0.9",
    "expo-font": "~14.0.9",
    "expo-image-picker": "~17.0.11",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.1",
    "victory-native": "^41.20.2"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "concurrently": "^10.0.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
